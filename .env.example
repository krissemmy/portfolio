# Required for the /consulting contact form to send email (server-side only,
# read in app/api/consulting/route.ts). Get a key from your existing Resend
# account at https://resend.com/api-keys. Without this set, the form returns
# a clear "not configured" error and the mailto fallback on the page still
# works.
RESEND_API_KEY=

# Optional. Where consulting inquiries are delivered. Leave unset to use the
# email in data/profile.ts (krissemmy17@gmail.com).
CONSULTING_CONTACT_EMAIL=

# Optional. Sender identity for outgoing inquiry emails. Leave unset to use
# Resend's shared sandbox address (onboarding@resend.dev) — no domain
# verification needed, but Resend only lets that address deliver to the
# email your Resend account is registered with. That's fine here since
# CONSULTING_CONTACT_EMAIL defaults to that same address (krissemmy17@gmail.com).
#
# krissemmy.com has no inbox/MX setup, but that isn't required to send from
# it: verifying a *sending* domain in Resend (Domains tab) only needs SPF/DKIM
# records, not a working mailbox. Once verified, set this to something like
# "Portfolio Consulting <consulting@krissemmy.com>" for a more polished
# sender address.
RESEND_FROM_EMAIL=
