# Worker secrets for POST /api/consulting (src/worker.ts).
# Production (values are not stored in this repo):
#   pnpm exec wrangler secret put RESEND_API_KEY
#   pnpm exec wrangler secret put CONSULTING_CONTACT_EMAIL
#   pnpm exec wrangler secret put RESEND_FROM_EMAIL   # optional
# Local `wrangler dev`: copy this file to .dev.vars. .dev.vars is gitignored.
#
# Get a key from the existing Resend account at https://resend.com/api-keys.
# Without RESEND_API_KEY, the form returns a clear "not configured" error and
# the mailto fallback on the page still works.
RESEND_API_KEY=

# Optional override. Where consulting inquiries are delivered. Leave unset to
# use profile.consultingEmail in data/profile.ts (consulting@krissemmy.com).
CONSULTING_CONTACT_EMAIL=

# Optional override. Sender identity for outgoing inquiry emails. Leave unset
# to use "Portfolio Contact <consulting@krissemmy.com>".
#
# krissemmy.com is verified in Resend for both sending (DKIM + SPF on the
# `send.` subdomain) and receiving (root MX -> Resend Inbound), so no sandbox
# fallback is needed. Any address on the domain works as a sender.
RESEND_FROM_EMAIL=
